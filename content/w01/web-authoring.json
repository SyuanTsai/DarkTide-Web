      ],
      "payload": {
        "name": "顱腦崩裂",
        "official": {
          "sourceRef": "official:ui:681e4980:loc_talent_psyker_brain_burst_improved_description:en:1",
          "sourceLocale": "en",
          "resource": "ui",
          "sourceHash": "681e4980",
          "key": "loc_talent_psyker_brain_burst_improved_description",
          "occurrence": 1,
          "sourceText": "Charge up your Psychic Power and release it to deal immense Damage to a Single Enemy.\n\nThis is an augmented version of {talent_old:%s} dealing {damage:%s} Damage.",
          "sourceTextSha256": "dcdd0219e870c7b177e4db1d434582d4ace1678a7304c116c705ad2165e6015b",
          "segments": [
            {
              "segmentId": "segment-1",
              "kind": "literal",
              "text": "Charge up your Psychic Power and release it to deal immense Damage to a Single Enemy.\n\nThis is an augmented version of ",
              "sha256": "75480d83821ba58feb6cfd3abe9d81f4f1f946acd09d779fcfe73d6d38d2b671"
            },
            {
              "segmentId": "segment-2",
              "kind": "template-placeholder",
              "text": "{talent_old:%s}",
              "sha256": "b84074878dbcd309d7d6d437e5e759ec642e7966bd432a10efb002fe702c061d"
            },
            {
              "segmentId": "segment-3",
              "kind": "literal",
              "text": " dealing ",
              "sha256": "4edf527b6f1584f29a34423e8509242ed2161fa6fc8c0dd28418f7d1a240d6ac"
            },
            {
              "segmentId": "segment-4",
              "kind": "template-placeholder",
              "text": "{damage:%s}",
              "sha256": "e0edcbc7d0e405c62c3b6d68240c8037158467a2196b37e871ccfa5ade6139dd"
            },
            {
              "segmentId": "segment-5",
              "kind": "literal",
              "text": " Damage.",
              "sha256": "c59411295516d9f3ed84b53aec422b3399d0bb785535227f6fbcdaec317f9d05"
            }
          ],
          "params": [
            {
              "name": "talent_old",
              "placeholder": "{talent_old:%s}",
              "status": "bound",
              "bindingRef": "official:ui:6f06e398:loc_ability_psyker_smite:en:1",
              "format": "official-name"
            },
            {
              "name": "damage",
              "placeholder": "{damage:%s}",
              "status": "bound",
              "bindingRef": "darktide:claim:psyker:brain-burst-improved-description-display-percent",
              "format": "signed-percent"
            }
          ],
          "localizations": {
            "zh-TW": {
              "origin": "official",
              "sourceRef": "official:ui:681e4980:loc_talent_psyker_brain_burst_improved_description:zh-TW:1",
              "sourceLocale": "zh-TW",
              "resource": "ui",
              "sourceHash": "681e4980",
              "key": "loc_talent_psyker_brain_burst_improved_description",
              "occurrence": 1,
              "sourceText": "積蓄靈能力量，釋放時可對單個敵人造成巨大傷害。\n\n該天賦是可造成{damage:%s}傷害的{talent_old:%s}的加強版。",
              "sourceTextSha256": "3c2c9776162b4a5b5e88615acdb3fb8d8a64f976c17a733fa6ae681d6392da27",
              "segments": [
                {
                  "segmentId": "segment-1",
                  "kind": "literal",
                  "text": "積蓄靈能力量，釋放時可對單個敵人造成巨大傷害。\n\n該天賦是可造成",
                  "sha256": "90db38f2cd20a87f38fd4e6acd5a8a75279da2ae4e197c3e96235ba69e8bd4d4"
                },
                {
                  "segmentId": "segment-2",
                  "kind": "template-placeholder",
                  "text": "{damage:%s}",
                  "sha256": "e0edcbc7d0e405c62c3b6d68240c8037158467a2196b37e871ccfa5ade6139dd"
                },
                {
                  "segmentId": "segment-3",
                  "kind": "literal",
                  "text": "傷害的",
                  "sha256": "b0c40a99136b52f3ed2405d07b1217683976c5fceaa49b06406025ed0623dcee"
                },
                {
                  "segmentId": "segment-4",
                  "kind": "template-placeholder",
                  "text": "{talent_old:%s}",
                  "sha256": "b84074878dbcd309d7d6d437e5e759ec642e7966bd432a10efb002fe702c061d"
                },
                {
                  "segmentId": "segment-5",
                  "kind": "literal",
                  "text": "的加強版。",
                  "sha256": "f141f500e7a84e040c65f34d49c19a1f4b7249db419e95e1e0825f5d4e970998"
                }
              ],
              "params": [
                {
                  "name": "damage",
                  "placeholder": "{damage:%s}",
                  "status": "bound",
                  "bindingRef": "darktide:claim:psyker:brain-burst-improved-description-display-percent",
                  "format": "signed-percent"
                },
                {
                  "name": "talent_old",
                  "placeholder": "{talent_old:%s}",
                  "status": "bound",
                  "bindingRef": "official:ui:6f06e398:loc_ability_psyker_smite:zh-TW:1",
                  "format": "official-name"
                }
              ]
            }
          }
        },
        "errata": [],
        "detailSections": {
          "effects": [
            {
              "itemId": "psyker-numerical-assumptions",
              "text": "以下數值不含其他加成或減免。"
            },
            {
              "itemId": "psyker-description-damage-parameter",
              "text": "相較於顱腦爆裂，顱腦崩裂傷害提高 50%（1.5 倍）；這項加成不適用於所有靈能攻擊。",
              "claimRefs": [
                "darktide:claim:psyker:brain-burst-improved-description-display-percent",
                "darktide:claim:psyker:brain-burst-improved-smite-damage-multiplier"
              ]
            },
            {
              "itemId": "psyker-base-hit-peril-cost",
              "text": "顱腦崩裂蓄力時，你會累積反噬；造成傷害後再增加 25%。",
              "claimRefs": [
                "darktide:claim:psyker:brain-burst-improved-normal-charge-base-time",
                "darktide:claim:psyker:brain-burst-improved-sticky-charge-base-time",
                "darktide:claim:psyker:brain-burst-improved-successful-hit-base-peril-ratio"
              ]
            }
          ],
          "conditions": [
            {
              "itemId": "psyker-normal-charge-condition",
              "text": "先蓄力再鎖定：未鎖定敵人也能蓄力；鎖定後接續蓄力進度。",
              "claimRefs": [
                "darktide:claim:psyker:brain-burst-improved-normal-charge-base-time"
              ]
            },
            {
              "itemId": "psyker-sticky-charge-condition",
              "text": "直接鎖定蓄力：先鎖定敵人，再蓄力。",
              "claimRefs": [
                "darktide:claim:psyker:brain-burst-improved-normal-charge-base-time",
                "darktide:claim:psyker:brain-burst-improved-sticky-charge-base-time"
              ]
            },
            {
              "itemId": "psyker-lock-on-charge-condition",
              "text": "鎖定後，移開準星也不會更換目標。",
              "claimRefs": [
                "darktide:claim:psyker:brain-burst-improved-normal-charge-base-time",
                "darktide:claim:psyker:brain-burst-improved-sticky-charge-base-time"
              ]
            }
          ],
          "calculation": [
            {
              "itemId": "psyker-estimate-assumptions",
              "text": "你的反噬從 0% 起算，且蓄力不中斷："
            },
            {
              "itemId": "psyker-normal-charge-peril-estimate",
              "text": "先蓄力再鎖定：約 3 秒蓄滿；1／2／3 秒時，你的反噬約 6.67%／13.33%／20%。",
              "claimRefs": [
                "darktide:claim:psyker:brain-burst-improved-normal-charge-base-time"
              ]
            },
            {
              "itemId": "psyker-sticky-charge-peril-estimate",
              "text": "直接鎖定蓄力：約 2 秒蓄滿；1／2 秒時，你的反噬約 10%／20%。",
              "claimRefs": [
                "darktide:claim:psyker:brain-burst-improved-sticky-charge-base-time"
              ]
            },
            {
              "itemId": "psyker-full-charge-peril-rate-estimate",
              "text": "滿蓄後繼續蓄力，你的反噬每秒約增加 9%。",
              "claimRefs": [
                "darktide:claim:psyker:brain-burst-improved-normal-charge-base-time",
                "darktide:claim:psyker:brain-burst-improved-sticky-charge-base-time"
              ]
            },
            {
              "itemId": "psyker-full-charge-hit-peril-estimate",
              "text": "顱腦崩裂蓄滿後立即造成傷害，你的反噬約 45%；多維持 1 秒則約 54%。",
              "claimRefs": [
                "darktide:claim:psyker:brain-burst-improved-normal-charge-base-time",
                "darktide:claim:psyker:brain-burst-improved-sticky-charge-base-time",
                "darktide:claim:psyker:brain-burst-improved-successful-hit-base-peril-ratio"
              ]
            }
          ],
          "notes": [
            {
              "itemId": "psyker-empty-cast-peril-cost",
              "text": "顱腦崩裂未造成傷害時，你不會再累積 25% 反噬；蓄力時累積的反噬仍保留。",
              "claimRefs": [
                "darktide:claim:psyker:brain-burst-improved-successful-hit-base-peril-ratio"
              ]
            }
          ],
          "extra": [
            {
              "itemId": "psyker-stagger-eligible-target-condition",
              "text": "以下僅適用於會被顱腦崩裂打出踉蹌的敵人：",
              "claimRefs": [
                "darktide:claim:psyker:brain-burst-improved-normal-charge-base-time",
                "darktide:claim:psyker:brain-burst-improved-sticky-charge-base-time"
              ]
            },
            {
              "itemId": "psyker-lock-on-direct-stagger-condition",
              "text": "直接鎖定：鎖定同一敵人超過 1 秒，顱腦崩裂使其輕微踉蹌一次。",
              "claimRefs": [
                "darktide:claim:psyker:brain-burst-improved-normal-charge-base-time",
                "darktide:claim:psyker:brain-burst-improved-sticky-charge-base-time"
              ]
            },
            {
              "itemId": "psyker-lock-on-transition-stagger-condition",
              "text": "先蓄力再鎖定：鎖定敵人超過 0.25 秒，顱腦崩裂使其輕微踉蹌一次。",
              "claimRefs": [
                "darktide:claim:psyker:brain-burst-improved-normal-charge-base-time",
                "darktide:claim:psyker:brain-burst-improved-sticky-charge-base-time"
              ]
            }
          ]
        }
      },
      "reviewState": "pending"
    },
